// Prisma schema for BeATUS Console
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  staff
}

enum ReferredBy {
  website
  social
  linktree
  friend_referral
  local_specialist
  other
}

enum SpecialistRegion {
  LV
  UA
}

enum SpecialistStatus {
  active
  inactive
}

enum SessionType {
  individual
  family
  child
  training
}

enum SessionStatus {
  booked
  completed
  cancelled
}

enum InvoiceLineItemType {
  session
  equipment
  training
}

enum InvoiceStatus {
  draft
  sent
  paid
  overdue
}

enum ContractPartyType {
  specialist
  vendor
  partner
}

enum EquipmentCategory {
  finished_good
  raw_material
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(staff)
  createdAt    DateTime @default(now())
}

model Client {
  id         String     @id @default(cuid())
  fullName   String
  phone      String?
  email      String?
  referredBy ReferredBy @default(other)
  notes      String?
  createdAt  DateTime   @default(now())

  sessions Session[]
  invoices Invoice[]

  @@index([fullName])
}

model Specialist {
  id             String           @id @default(cuid())
  fullName       String
  phone          String?
  email          String?
  location       String
  region         SpecialistRegion
  specialty      String
  status         SpecialistStatus @default(active)
  onboardingDate DateTime         @default(now())
  bio            String?

  sessions  Session[]
  contracts Contract[]
  equipment Equipment[]

  @@index([fullName])
  @@index([region])
  @@index([status])
}

model Session {
  id           String        @id @default(cuid())
  clientId     String
  specialistId String
  sessionType  SessionType
  scheduledAt  DateTime
  status       SessionStatus @default(booked)
  price        Decimal       @db.Decimal(10, 2)
  createdAt    DateTime      @default(now())

  client     Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  specialist Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  invoice    Invoice?

  @@index([specialistId, scheduledAt])
  @@index([clientId])
}

model InvoiceLineItem {
  id          String              @id @default(cuid())
  invoiceId   String
  type        InvoiceLineItemType
  description String
  amount      Decimal             @db.Decimal(10, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Invoice {
  id          String        @id @default(cuid())
  clientId    String
  sessionId   String?       @unique
  totalAmount Decimal       @db.Decimal(10, 2)
  issueDate   DateTime      @default(now())
  dueDate     DateTime
  status      InvoiceStatus @default(draft)
  sentAt      DateTime?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  client    Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  session   Session?          @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  lineItems InvoiceLineItem[]

  @@index([status, dueDate])
  @@index([clientId])
}

model Contract {
  id             String            @id @default(cuid())
  partyType      ContractPartyType
  partyName      String
  specialistId   String?
  agreementType  String
  startDate      DateTime
  expiryDate     DateTime
  renewalHistory DateTime[]        @default([])
  fileUrl        String?
  createdAt      DateTime          @default(now())

  specialist Specialist? @relation(fields: [specialistId], references: [id], onDelete: SetNull)

  @@index([expiryDate])
  @@index([partyType])
}

model Equipment {
  id                      String            @id @default(cuid())
  category                EquipmentCategory @default(finished_good)
  type                    String
  location                String
  responsibleSpecialistId String?
  serialNumber            String?
  purchaseDate            DateTime?
  lastGrainChange         DateTime?
  nextGrainChangeDue      DateTime?
  notes                   String?
  createdAt               DateTime          @default(now())

  responsibleSpecialist Specialist? @relation(fields: [responsibleSpecialistId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([type])
  @@index([location])
  @@index([nextGrainChangeDue])
}
